#!name=LINE App 新闻报错修复(Taboola合流版)
#!desc=修复 LINE TODAY 新闻提示临时性错误及页面空白。已全面补齐 Taboola 新闻信息流引擎、苹果位置验证、谷歌样式库及 LINE 核心域名。
#!category=社交优化

[Rule]
# ----- Taboola 新闻信息流与广告引擎（解决空白的关键）-----
DOMAIN-SUFFIX,taboola.com,PROXY

# ----- 苹果位置与设备验证服务 -----
DOMAIN-SUFFIX,gspe35-ssl.ls.apple.com,PROXY
DOMAIN,gspe35-ssl.ls.apple.com,PROXY

# ----- 谷歌前端样式、验证与广告接口 -----
DOMAIN-SUFFIX,www.gstatic.com,PROXY
DOMAIN-SUFFIX,fonts.gstatic.com,PROXY
DOMAIN-SUFFIX,fonts.googleapis.com,PROXY
DOMAIN-SUFFIX,securepubads.g.doubleclick.net,PROXY
DOMAIN-SUFFIX,doubleclick.net,PROXY

# ----- 顶级高优先级关键字拦截 -----
DOMAIN-KEYWORD,line,PROXY
DOMAIN-KEYWORD,naver,PROXY
DOMAIN-KEYWORD,livedoor,PROXY
DOMAIN-KEYWORD,linetoday,PROXY

# ----- 核心域名后缀强校验 -----
DOMAIN-SUFFIX,line.me,PROXY
DOMAIN-SUFFIX,line-apps.com,PROXY
DOMAIN-SUFFIX,line-scdn.net,PROXY
DOMAIN-SUFFIX,lin.ee,PROXY
DOMAIN-SUFFIX,line.naver.jp,PROXY
DOMAIN-SUFFIX,naver.jp,PROXY
DOMAIN-SUFFIX,naver.com,PROXY
DOMAIN-SUFFIX,livedoor.com,PROXY
DOMAIN-SUFFIX,livedoor.biz,PROXY
DOMAIN-SUFFIX,lnwfile.com,PROXY

[Host]
*.line.me = proxy
*.line-apps.com = proxy
*.line-scdn.net = proxy
*.lin.ee = proxy
*.naver.jp = proxy
*.naver.com = proxy
*.line.naver.jp = proxy
*.livedoor.com = proxy