

[Rule]
#!name=LINE App 新闻报错修复
#!desc=修复 LINE TODAY 新闻提示临时性错误、内容转圈、图片不显示的问题。强制将 LINE 与母公司 NAVER 的核心服务、新闻 CDN 送入代理，并在底层强制启用远程 DNS 解析以防本地污染。
#!category=社交优化

[Rule]
# ----- LINE 主服务与图片/视频 CDN -----
DOMAIN-SUFFIX,line.me,PROXY
DOMAIN-SUFFIX,line-apps.com,PROXY
DOMAIN-SUFFIX,line-scdn.net,PROXY
DOMAIN-SUFFIX,lin.ee,PROXY

# ----- LINE TODAY 新闻与母公司 NAVER 核心接口（报错重灾区）-----
DOMAIN-SUFFIX,line.naver.jp,PROXY
DOMAIN-SUFFIX,naver.jp,PROXY
DOMAIN-SUFFIX,naver.com,PROXY
DOMAIN-SUFFIX,livedoor.com,PROXY
DOMAIN-SUFFIX,livedoor.biz,PROXY
DOMAIN-SUFFIX,lnwfile.com,PROXY

# ----- 关键字兜底拦截 -----
DOMAIN-KEYWORD,linecorp,PROXY
DOMAIN-KEYWORD,linetoday,PROXY

[Host]
# 强制让小火箭在本地跳过 DNS 解析，直接将原始域名托付给远程代理节点解析
*.line.me = proxy
*.line-apps.com = proxy
*.line-scdn.net = proxy
*.lin.ee = proxy
*.naver.jp = proxy
*.naver.com = proxy