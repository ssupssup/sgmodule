#!name=防泄露与分流优化模块(无泄露加固版)
#!desc=最近更新: 2026-08-03 | 彻底关闭 IPv6 旁路、防系统 DNS 旁路泄露、Fake-IP 闭环

[General]
# 1. 禁用系统自带 DNS 转发与 IPv6，强制小火箭接管
dns-direct-system = false
dns-fallback-system = false
prefer-ipv6 = false

# 2. 强制系统 DNS 劫持 (拦截所有 UDP 53 端口暗度陈仓流量)
hijack-dns = 8.8.8.8:53, 8.8.4.4:53, 1.1.1.1:53, 1.0.0.1:53, 223.5.5.5:53, 119.29.29.29:53, *:53

# 3. 远程全加密 DNS (纯 IP 形式 DoH，消灭死锁)
dns-server = https://1.1.1.1/dns-query, https://8.8.8.8/dns-query

# 4. 国内直连全加密 DNS (纯 IP 形式 DoH)
direct-dns-server = https://223.5.5.5/dns-query, https://1.12.12.12/dns-query

# 5. 全局 Fake-IP 模式 (远端节点解析，杜绝 DNS 泄露)
dns-mode = fake-ip

# 6. 必须使用 Real-IP 的域名列表 (保留极简必要的直连域名)
fake-ip-filter = *.dygangs.me, *.5266ys.com, *.66tutup.com, *.200610.cc.cd, *.200610.xyz, *.cn1.gi-de.com, *.lc0011.net, *.pm001.net, *.lan, *.local, *.home.arpa, captive.apple.com, time*.apple.com, time*.windows.com, *.ntp.org, msftconnecttest.com, msftncsi.com

[Rule]
# ==========================================
# 1. 局域网与内网直连 (最高优先级，保障 NAS/软路由连接)
# ==========================================
IP-CIDR,10.0.0.0/8,DIRECT
IP-CIDR,172.16.0.0/12,DIRECT
IP-CIDR,192.168.0.0/16,DIRECT
IP-CIDR,127.0.0.0/8,DIRECT
IP-CIDR,224.0.0.0/4,DIRECT
GEOIP,LAN,DIRECT

# ==========================================
# 2. 拦截 WebRTC 与公共 STUN 泄露
# ==========================================
DOMAIN-SUFFIX,stun.l.google.com,REJECT
DOMAIN-SUFFIX,stun.cloudflare.com,REJECT
DOMAIN-KEYWORD,stunserver,REJECT

# ==========================================
# 3. 防泄露测试网站强制走代理 (防止测试时本地 DNS 污染干扰)
# ==========================================
DOMAIN-SUFFIX,ippure.com,PROXY
DOMAIN-SUFFIX,browserleaks.com,PROXY
DOMAIN-SUFFIX,dnsleaktest.com,PROXY
DOMAIN-SUFFIX,dnsleak.com,PROXY
DOMAIN-SUFFIX,ipleak.net,PROXY
DOMAIN-SUFFIX,expressvpn.com,PROXY
DOMAIN-SUFFIX,perfect-privacy.com,PROXY
DOMAIN-SUFFIX,ip.skk.moe,PROXY

# ==========================================
# 4. 自动直连自定义域名
# ==========================================
DOMAIN-SUFFIX,dygangs.me,DIRECT
DOMAIN-SUFFIX,5266ys.com,DIRECT
DOMAIN-SUFFIX,66tutup.com,DIRECT
DOMAIN-SUFFIX,200610.cc.cd,DIRECT
DOMAIN-SUFFIX,200610.xyz,DIRECT
DOMAIN-SUFFIX,cn1.gi-de.com,DIRECT
DOMAIN-SUFFIX,lc0011.net,DIRECT
DOMAIN-SUFFIX,pm001.net,DIRECT

# ==========================================
# 5. 精细分流规则
# ==========================================
# 1) Copilot / AI 服务：置顶强制走代理
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/refs/heads/master/rule/Shadowrocket/Copilot/Copilot.list,PROXY

# 2) 微软业务：使用精简版直连列表（防止误杀 Copilot 与域名解析泄露）
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Shadowrocket/Microsoft/Microsoft_Direct.list,DIRECT

# 3) 苹果服务分流
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Shadowrocket/Apple/Apple_Language_No_Resolve.list,DIRECT
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Shadowrocket/Apple/Apple.list,PROXY

# ==========================================
# 6. 国内 IP 直连与最终兜底
# ==========================================
GEOIP,CN,DIRECT
FINAL,PROXY
