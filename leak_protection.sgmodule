#!name=防泄露与分流优化模块(终极安全定稿版)
#!desc=最近更新: 2026-08-03 | 基于 0 泄露硬拦截基座 + 纯 IP DoH (无死锁) + Copilot 代理/微软其余直连
#!system-dns-server=false
#!system-fallback-dns-server=false
#!hijack-dns=8.8.8.8:53, 8.8.4.4:53, 1.1.1.1:53, 1.0.0.1:53, 223.5.5.5:53, 119.29.29.29:53
#!dns-server=https://1.1.1.1/dns-query, https://8.8.8.8/dns-query
#!direct-dns-server=https://223.5.5.5/dns-query, https://1.12.12.12/dns-query
#!dns-mode=fake-ip
#!fake-ip-filter=*.dygangs.me, *.5266ys.com, *.66tutup.com, *.200610.cc.cd, *.200610.xyz, *.cn1.gi-de.com, *.lc0011.net, *.pm001.net, *.lan, *.local, *.home.arpa, *.workgroup, *.invalid, *.localhost, *.test, *.localdomain, captive.apple.com, time*.apple.com, time*.asia.apple.com, time*.windows.com, time*.nist.gov, *.ntp.org, msftconnecttest.com, msftncsi.com, *.mp.weixin.qq.com

[Rule]
# ==========================================
# 1. 局域网与内网直连 (最高优先级，保障 NAS/软路由连接)
# ==========================================
IP-CIDR,10.0.0.0/8,DIRECT
IP-CIDR,172.16.0.0/12,DIRECT
IP-CIDR,192.168.0.0/16,DIRECT
IP-CIDR,127.0.0.0/8,DIRECT
IP-CIDR,224.0.0.0/4,DIRECT
GEOIP,LAN,DIRECT

# ==========================================
# 2. 封堵 WebRTC / STUN 泄露 (原封不动保留原版物理端口硬拦截)
# ==========================================
DOMAIN-KEYWORD,stun,REJECT
DOMAIN-KEYWORD,turn,REJECT
DOMAIN-SUFFIX,stun.l.google.com,REJECT
AND,((PROTOCOL,UDP),(DEST-PORT,3478)),REJECT
AND,((PROTOCOL,UDP),(DEST-PORT,5349)),REJECT

# ==========================================
# 3. 防泄露测试网站强走代理 (防止 GEOIP 判断前触发本地 DNS 查询)
# ==========================================
DOMAIN-SUFFIX,ippure.com,PROXY
DOMAIN-SUFFIX,browserleaks.com,PROXY
DOMAIN-SUFFIX,dnsleaktest.com,PROXY
DOMAIN-SUFFIX,dnsleak.com,PROXY
DOMAIN-SUFFIX,ipleak.net,PROXY
DOMAIN-SUFFIX,expressvpn.com,PROXY
DOMAIN-SUFFIX,perfect-privacy.com,PROXY
DOMAIN-SUFFIX,ip.skk.moe,PROXY

# ==========================================
# 4. 自动直连自定义域名
# ==========================================
DOMAIN-SUFFIX,dygangs.me,DIRECT
DOMAIN-SUFFIX,5266ys.com,DIRECT
DOMAIN-SUFFIX,66tutup.com,DIRECT
DOMAIN-SUFFIX,200610.cc.cd,DIRECT
DOMAIN-SUFFIX,200610.xyz,DIRECT
DOMAIN-SUFFIX,cn1.gi-de.com,DIRECT
DOMAIN-SUFFIX,lc0011.net,DIRECT
DOMAIN-SUFFIX,pm001.net,DIRECT

# ==========================================
# 5. 远程规则集精细分流 (实现：仅 Copilot 代理，微软其余直连)
# ==========================================
# 1) Copilot / AI 服务：置顶优先捕获走代理
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/refs/heads/master/rule/Shadowrocket/Copilot/Copilot.list,PROXY

# 2) 微软其余业务：直连 (Outlook / OneDrive / Office365 / Xbox 等)
RULE-SET,https://raw.githubusercontent.com/Loyalsoldier/clash-rules/release/microsoft.txt,DIRECT

# 3) 苹果服务分流：国内 CDN 直连，其他走代理
RULE-SET,https://raw.githubusercontent.com/Loyalsoldier/clash-rules/release/apple-cn.txt,DIRECT
RULE-SET,https://raw.githubusercontent.com/Loyalsoldier/clash-rules/release/apple.txt,PROXY

# ==========================================
# 6. 国内 IP 直连与最终兜底
# ==========================================
GEOIP,CN,DIRECT
FINAL,PROXY
